# Copy this file to .env and fill in values — never commit .env
# All APP_* variables are loaded by AppSettings (pydantic-settings, env_prefix=APP_)

APP_ENV=development
SECRET_KEY=change-me-in-production

# PostgreSQL (also used directly via DATABASE_URL for Alembic migrations)
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432
APP_POSTGRES_USER=postgres
APP_POSTGRES_PASSWORD=change-me-in-production
APP_POSTGRES_DB=eu_multitenant
APP_DB_POOL_SIZE=20
APP_DB_MAX_OVERFLOW=10
DATABASE_URL=postgresql+psycopg2://postgres:change-me-in-production@localhost:5432/eu_multitenant

# Redis
APP_REDIS_URL=redis://localhost:6379/0

# JWT (RS256 — generate with: openssl genrsa -out private.pem 2048)
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=
APP_JWT_ISSUER=eu-multi-tenant-platform
APP_JWT_ACCESS_TOKEN_MINUTES=15
APP_JWT_REFRESH_TOKEN_DAYS=7

# Celery
APP_CELERY_BROKER_URL=redis://localhost:6379/1
APP_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Monitoring
APP_PROMETHEUS_URL=http://localhost:9090

# Logging
APP_LOG_LEVEL=INFO

# CORS (comma-separated origins, or * for development)
APP_CORS_ORIGINS=http://localhost:3000
